{
  "name": "scriptbox",
  "version": "1.0.0",
  "description": "Now run any programming language in your browser",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "wasm",
    "webassembly",
    "code-runner",
    "sandbox",
    "execution",
    "client-side"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "cppbolt": "^1.1.0",
    "pyodide": "^314.0.3",
    "tsdown": "^0.22.14",
    "typescript": "6.0.3",
    "webr": "^0.6.0",
    "yaegi-wasm": "1.0.2"
  }
}
